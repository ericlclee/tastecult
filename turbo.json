{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^db:generate", "db:generate"]
    }
  }
}
