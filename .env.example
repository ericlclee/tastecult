# Postgres (docker compose up -d)
DATABASE_URL=postgresql://tastecult:tastecult@localhost:54329/tastecult
TEST_DATABASE_URL=postgresql://tastecult:tastecult@localhost:54329/tastecult_test
# Migrations and imports. Leave unset locally (they fall back to DATABASE_URL). On Supabase,
# use the session pooler URL (port 5432), not the transaction pooler the API uses at runtime.
# DIRECT_URL=

# Supabase — project settings > API
SUPABASE_URL=
# Used to verify user JWTs issued by Supabase Auth
SUPABASE_JWT_SECRET=
# Server-only: signed upload URLs, deleting auth users on account deletion
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=dish-photos
