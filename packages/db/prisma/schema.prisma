// Domain model for TasteCult. Things Prisma can't express (pg_trgm extension,
// tier CHECK constraint) live in hand-edited migration SQL — keep them in sync.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Extensionless imports inside the generated client, so Next.js (Turbopack)
  // can bundle it — it can't resolve "./file.js" to file.ts
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DishStatus {
  APPROVED
  PENDING
  REJECTED
}

/// Keep in sync with REACTION_TYPES in packages/shared-types/src/reactions.ts
enum ReactionType {
  WANT
  FIRE
  CLAP
  LOL
}

enum ReportTarget {
  USER
  RATING
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  // Supabase auth.uid — identity (email etc.) lives in Supabase, not here
  id          String   @id
  username    String   @unique
  displayName String?
  avatarUrl   String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())

  visits              Visit[]
  ratings             Rating[]
  reactions           Reaction[]
  comments            Comment[]
  following           Follow[]             @relation("Following")
  followers           Follow[]             @relation("Followers")
  blocking            Block[]              @relation("Blocking")
  blockedBy           Block[]              @relation("BlockedBy")
  requestedDishes     Dish[]
  menuItemsCreated    MenuItem[]
  reports             Report[]
  missingPlaceReports MissingPlaceReport[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Sourced from the UK FSA Food Hygiene Rating Scheme open data — never user-created.
model Restaurant {
  id             String    @id @default(cuid())
  fhrsId         Int       @unique
  name           String
  address        String?
  postcode       String?
  latitude       Float?
  longitude      Float?
  businessType   String
  businessTypeId Int
  localAuthority String
  hygieneRating  String?
  // Set when the business disappears from the FHRS feed; logs keep referencing it
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  menuItems MenuItem[]
  visits    Visit[]

  @@index([latitude, longitude])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Restaurant_name_trgm_idx")
}

model Cuisine {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  // Roll-ups so filters work at any level: Thai -> Southeast Asian -> Asian
  region      String
  macroRegion String

  dishes  DishCuisine[]
  ratings Rating[]
}

/// Canonical dish from the curated list — shared across restaurants so the
/// same dish can be compared between places.
model Dish {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  status        DishStatus @default(APPROVED)
  requestedById String?
  mergedIntoId  String?
  // Variant -> root parent (Pizza Margherita -> Pizza) so ratings can roll up.
  // Not the same as mergedIntoId, which marks duplicates an admin merged away.
  parentId      String?
  category      String?
  // Alternative and native-language names, for search
  otherNames    String[]   @default([])
  ingredients   String[]   @default([])
  // London review mentions from the catalogue import; orders search results
  popularity    Int        @default(0)
  createdAt     DateTime   @default(now())

  cuisines    DishCuisine[]
  requestedBy User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  mergedInto  Dish?         @relation("DishMerge", fields: [mergedIntoId], references: [id])
  mergedFrom  Dish[]        @relation("DishMerge")
  parent      Dish?         @relation("DishVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants    Dish[]        @relation("DishVariants")
  menuItems   MenuItem[]

  @@index([status])
  @@index([parentId])
  @@index([popularity])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Dish_name_trgm_idx")
}

/// A dish belongs to one or more cuisines, all equal — there's no primary.
/// Hummus is Middle Eastern, North African and Turkish.
model DishCuisine {
  dishId    String
  cuisineId String

  dish    Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  cuisine Cuisine @relation(fields: [cuisineId], references: [id])

  @@id([dishId, cuisineId])
  @@index([cuisineId])
}

/// A dish as a specific restaurant serves it. Ratings group here, so two
/// differently-named ramens at one restaurant are rated separately.
model MenuItem {
  id              String   @id @default(cuid())
  restaurantId    String
  dishId          String
  alias           String?
  // '' when there's no alias, so the unique constraint still dedupes
  normalizedAlias String   @default("")
  createdById     String?
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  dish       Dish       @relation(fields: [dishId], references: [id])
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ratings    Rating[]

  @@unique([restaurantId, dishId, normalizedAlias])
  @@index([dishId])
}

/// One trip to one restaurant on one day, holding every dish logged on it.
/// A person can have more than one visit to the same restaurant on the same
/// date (lunch and dinner), so there's deliberately no unique key on that.
model Visit {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  visitedAt    DateTime @db.Date
  /// About the visit as a whole; each dish keeps its own note too
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  ratings    Rating[]
  photos     VisitPhoto[]

  @@index([userId, visitedAt])
  @@index([restaurantId, visitedAt])
  @@index([createdAt])
}

/// A photo belongs to the visit, and may also point at one dish logged on it.
/// `ratingId` is cleared rather than cascaded when that dish log goes, so a
/// photo of the table survives removing one dish from the visit.
model VisitPhoto {
  id        String   @id @default(cuid())
  visitId   String
  ratingId  String?
  path      String   @unique
  /// Orders the photos within a visit
  position  Int      @default(0)
  createdAt DateTime @default(now())

  visit  Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  rating Rating? @relation(fields: [ratingId], references: [id], onDelete: SetNull)

  @@index([visitId, position])
  @@index([ratingId])
}

/// One dish logged on a visit. Every log is a new row; stats use each user's latest.
model Rating {
  id         String   @id @default(cuid())
  visitId    String
  // Denormalised from the visit so every existing query, index and ordering
  // clause keeps working without a join. Kept in sync whenever a visit changes.
  userId     String
  menuItemId String
  // 1–5: Skip, Fine, Good, Must-order, Life-changing (CHECK constraint in migration)
  tier       Int
  visitedAt  DateTime @db.Date
  // Optional, the logger's call for this dish. Any cuisine is valid: the UI
  // suggests the dish's cuisines and an "Other" option unlocks the rest.
  cuisineId  String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  cuisine  Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: SetNull)

  reactions Reaction[]
  comments  Comment[]
  photos    VisitPhoto[]

  @@index([menuItemId, userId, visitedAt])
  @@index([userId, visitedAt])
  @@index([cuisineId])
  @@index([visitId])
}

/// One reaction per person per log, from a small fixed set; changing it replaces the old one.
model Reaction {
  ratingId  String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ratingId, userId])
  @@index([userId])
}

/// A comment on a log. Its author or the log's owner can delete it.
model Comment {
  id        String   @id @default(cuid())
  ratingId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ratingId, createdAt])
  @@index([userId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType ReportTarget
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
}

model MissingPlaceReport {
  id         String    @id @default(cuid())
  userId     String
  name       String
  address    String?
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
